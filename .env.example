# Jaguarete Configuration
# Copy this file to .env and fill in your values

# ---- Security ----
JAGUARETE_SECRET_KEY=change-me-use-openssl-rand-hex-32

# ---- LLM Provider ----
# Options: openai, claude, ollama
JAGUARETE_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Ports ----
API_PORT=8000
WEB_PORT=3000
CHROMA_PORT=8001

# ---- CORS ----
JAGUARETE_CORS_ORIGINS=http://localhost:3000
